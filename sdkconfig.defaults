CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Меньше звука в полёте: 2 трансфера по 2 мс (задержка ноты)
CONFIG_UAC_NUM_ISOC_URBS=2
CONFIG_UAC_NUM_PACKETS_PER_URB=2
# Два синта Plaits: запас по процессору
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Встроенная PSRAM 2 МБ (quad): буферы дилэя и статтера. Только явные запросы, malloc остаётся во внутренней.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
