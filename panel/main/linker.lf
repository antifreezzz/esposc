# Горячие функции отрисовки LVGL - во внутреннюю память. Код панели исполняется из PSRAM через кэш команд, и на
# полной перерисовке экрана LVGL не помещается в кэш: профиль выборкой (стенд UI_BENCH, ui_bench.c) ровный, без
# одной тяжёлой функции. Список - верх этого профиля по отношению выборок к размеру, ~17 КБ внутренней RAM.
[mapping:lvgl_hot]
archive: liblvgl__lvgl.a
entries:
    lv_draw_sw_blend_to_rgb565:lv_draw_sw_blend_color_to_rgb565 (noflash)
    lv_string_builtin:lv_memset (noflash)
    lv_draw_sw_blend:lv_draw_sw_blend (noflash)
    lv_draw_label:lv_draw_label_iterate_characters (noflash)
    lv_font_fmt_txt:lv_font_get_bitmap_fmt_txt (noflash)
    lv_draw_sw_mask:lv_draw_mask_radius (noflash)
    lv_draw_sw_fill:lv_draw_sw_fill (noflash)
    lv_event:lv_event_send (noflash)
    lv_draw:lv_draw_dispatch_layer (noflash)
    lv_string_builtin:lv_memcpy (noflash)
    lv_area:lv_area_intersect (noflash)
    lv_text:lv_text_get_next_line (noflash)
    lv_obj_style:get_selector_style_prop (noflash)
    lv_style:lv_style_prop_get_default (noflash)
    lv_obj_style:lv_obj_get_style_prop_internal (noflash)
    lv_obj:lv_obj_event (noflash)
    lv_draw_label:lv_draw_unit_draw_letter_internal (noflash)
    lv_draw:lv_draw_finalize_task_creation (noflash)
    lv_utils:lv_utils_bsearch (noflash)
    lv_draw_buf:lv_draw_buf_goto_xy (noflash)
    lv_obj_style:get_prop_core (noflash)
    lv_draw_sw:dispatch (noflash)
    lv_tlsf:remove_free_block (noflash)
    lv_array:lv_array_at (noflash)
    lv_draw:lv_draw_add_task (noflash)
    lv_tlsf:lv_tlsf_free (noflash)
    lv_font_fmt_txt:kern_pair_8_compare (noflash)
    lv_draw_rect:lv_draw_rect (noflash)
    lv_draw_label:lv_draw_label (noflash)
    lv_draw:lv_draw_dispatch (noflash)
    lv_draw_rect:lv_draw_fill (noflash)
    lv_mem_core_builtin:lv_malloc_core (noflash)
    lv_font_fmt_txt:lv_font_get_glyph_dsc_fmt_txt (noflash)
    lv_color:lv_color_format_get_bpp (noflash)
    lv_mem_core_builtin:lv_free_core (noflash)
    lv_draw_sw_mask:lv_draw_sw_mask_apply (noflash)
    lv_draw_label:lv_draw_label_dsc_init (noflash)
    lv_draw_sw:lv_draw_sw_get_blend_handler (noflash)
    lv_obj_event:event_send_core (noflash)
    lv_mem:lv_free (noflash)
    lv_draw:lv_draw_cleanup_task (noflash)
    lv_refr:lv_obj_redraw (noflash)
    lv_draw_sw_letter:draw_letter_cb (noflash)
