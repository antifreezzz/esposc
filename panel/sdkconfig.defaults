CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# RGB-экран из PSRAM: кэш данных побольше, иначе экран дёргается при нагрузке на флэш
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# Потерянное прерывание буфера экрана сдвигало бы картинку насовсем: развёртка перезапускается по кадровому импульсу
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
# LVGL: куча на все объекты экрана (меню, свои страницы, сцены, редактор, Grids); 96 КБ не хватило экрану Grids
CONFIG_LV_MEM_SIZE=131072
